<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Lexico.Views.HomePageView"
    BackgroundColor="White"
    NavigationPage.HasNavigationBar="False">

    <!-- Style wykorzystywane przez etykiety na ekranie głównym. -->
    <ContentPage.Resources>
        <Style x:Key="Value" TargetType="Label">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="TextColor" Value="#1C1E2B" />
        </Style>

        <Style x:Key="Caption" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="#9A9CA8" />
        </Style>
    </ContentPage.Resources>

    <!-- Główny obszar strony umożliwiający przewijanie. -->
    <ScrollView>
        <VerticalStackLayout Padding="24,48,24,24" Spacing="16">

            <!-- Nagłówek z godziną, datą i ustawieniami. -->
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout>
                    <Label Text="{Binding Time}" FontSize="24" TextColor="#2B2D42" />
                    <Label Text="{Binding Date}" FontSize="40" TextColor="#1C1E2B" />
                </VerticalStackLayout>

                <Label Grid.Column="1" Text="⚙" FontSize="28" TextColor="#2F5089" VerticalOptions="Start">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSettingsTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <!-- Karta pokazująca liczbę słówek pozostałych na dzisiaj. -->
            <Border
                BackgroundColor="#E6E8EE"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 12"
                HeightRequest="180"
                Padding="24">

                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.25" Radius="6" Offset="0,3" />
                </Border.Shadow>

                <VerticalStackLayout VerticalOptions="End">
                    <Label Text="{Binding WordsLeft}" FontSize="44" FontAttributes="Bold" TextColor="#2F5089" />
                    <Label Text="words left to learn today" FontSize="20" TextColor="#2B2D42" />
                </VerticalStackLayout>
            </Border>

            <!-- Przycisk rozpoczynający naukę. -->
            <Button
                Text="Start Recalling"
                Clicked="OnStartClicked"
                BackgroundColor="#2F5089"
                TextColor="White"
                CornerRadius="8" />

            <!-- Przycisk pokazujący lub ukrywający ulubione słówka. -->
            <Button
                Text="{Binding FavoritesButtonText}"
                Clicked="OnFavoritesClicked"
                BackgroundColor="#E8EDF6"
                TextColor="#2F5089"
                CornerRadius="8" />

            <!-- Lista ulubionych słówek, domyślnie ukryta. -->
            <VerticalStackLayout
                IsVisible="{Binding IsFavoritesVisible}"
                Spacing="10">

                <Label
                    Text="Moje ulubione słówka"
                    FontSize="22"
                    FontAttributes="Bold"
                    TextColor="#1C1E2B" />

                <!-- Wyświetla wszystkie słówka zapisane jako ulubione. -->
                <VerticalStackLayout
                    BindableLayout.ItemsSource="{Binding FavoriteWords}"
                    Spacing="8">

                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border
                                BackgroundColor="#F2F4F8"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                Padding="14">

                                <Grid ColumnDefinitions="*,Auto">
                                    <Label
                                        Text="{Binding Value.Word}"
                                        FontSize="17"
                                        TextColor="#1C2A4A"
                                        VerticalOptions="Center" />

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding Value.Level}"
                                        FontSize="14"
                                        TextColor="#2F5089"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                
            </VerticalStackLayout>

            <!-- Nazwa aktualnego kursu. -->
            <Label
                Text="{Binding CourseTitle}"
                FontSize="24"
                TextColor="#1C1E2B"
                Margin="0,16,0,0" />

            <!-- Procentowy postęp kursu i pasek postępu. -->
            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding Percent}" Style="{StaticResource Value}" />
                <Label Text="Course Progress" Style="{StaticResource Caption}" />
                <ProgressBar
                    Progress="{Binding CourseProgress}"
                    ProgressColor="#2F5089"
                    BackgroundColor="#E6E8EE"
                    HeightRequest="10" />
            </VerticalStackLayout>

            <!-- Liczba powtórzonych słówek. -->
            <VerticalStackLayout>
                <Label Text="{Binding Reviewed}" Style="{StaticResource Value}" />
                <Label Text="Words Reviewed" Style="{StaticResource Caption}" />
            </VerticalStackLayout>

            <!-- Liczba słówek do ponownej nauki. -->
            <VerticalStackLayout>
                <Label Text="{Binding ToReview}" Style="{StaticResource Value}" />
                <Label Text="Words to Review Again" Style="{StaticResource Caption}" />
            </VerticalStackLayout>

            <!-- Liczba opanowanych słówek. -->
            <VerticalStackLayout>
                <Label Text="{Binding Learned}" Style="{StaticResource Value}" />
                <Label Text="Words Learned" Style="{StaticResource Caption}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
