<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lexico.Views.WelcomePageView"
             Title=""
             BackgroundColor="#325387">
    <Grid>
        <Image
            Source="welcoming_screen_bg.png"
            Aspect="AspectFill" />

        <Grid Padding="20">
            <Image
                Source="lexico_logo_small.png"
                WidthRequest="50"
                HorizontalOptions="Start"
                VerticalOptions="Start" />

            <VerticalStackLayout
                VerticalOptions="End"
                Spacing="5">

                <Label
                    Text="Learn english in harmony"
                    FontSize="20"
                    TextColor="White" />

                <Label
                    Text="A cleaner, tidier way to master new words and track your progress."
                    FontSize="30"
                    TextColor="White" />

                <Button
                    Clicked="Button_Clicked"
                    FontFamily="OpenSansRegular"
                    Margin="0, 20, 0, 0"
                    Text=">"
                    WidthRequest="60"
                    HeightRequest="60"
                    CornerRadius="30"
                    BackgroundColor="White"
                    TextColor="Black"
                    FontSize="28"
                    Padding="0"
                    HorizontalOptions="End"
                    VerticalOptions="Center" />
                </VerticalStackLayout>
        </Grid>
    </Grid>

</ContentPage>